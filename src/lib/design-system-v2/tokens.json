    "ai": {
      "suggestion": "#8B5CF6",
      "background": "#F5F3FF",
      "border": "#DDD6FE",
      "approved": "#10B981",
      "rejected": "#EF4444",
      "thinking": "#A78BFA"
    },
    "neutral": {
      "50": "#F9FAFB",
