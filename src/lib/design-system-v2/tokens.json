      "700": "#374151",
      "800": "#1F2937",
      "900": "#111827",
      "950": "#030712"
    }
  },
  "typography": {
    "fontFamily": {
      "heading": "DM Sans",
      "body": "Inter",
      "mono": "JetBrains Mono"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem",
      "6xl": "3.75rem"
    },
    "lineHeight": {
      "tight": 1.25,
      "normal": 1.5,
      "relaxed": 1.8,
      "loose": 2
    },
    "fontWeight": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "compact": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "0.75rem",
      "lg": "1rem",
      "xl": "1.5rem",
      "2xl": "2rem"
    },
    "default": {
      "xs": "0.5rem",
      "sm": "0.75rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem"
    },
    "relaxed": {
      "xs": "0.75rem",
      "sm": "1rem",
      "md": "1.5rem",
      "lg": "2rem",
      "xl": "3rem",
      "2xl": "4rem"
    }
  },
  "radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1.5rem",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,0.05)",
    "md": "0 4px 6px rgba(0,0,0,0.07)",
    "lg": "0 10px 15px rgba(0,0,0,0.1)",
    "xl": "0 20px 25px rgba(0,0,0,0.12)",
    "2xl": "0 25px 50px rgba(0,0,0,0.15)",
    "ai": "0 0 0 2px #DDD6FE, 0 8px 24px rgba(139, 92, 246, 0.15)",
    "glow": "0 0 20px rgba(139, 92, 246, 0.3)"
  },
  "motion": {
    "duration": {
      "fast": "150ms",
      "base": "300ms",
      "slow": "500ms",
      "slower": "800ms"
    },
    "easing": {
      "linear": "linear",
      "easeIn": "cubic-bezier(0.4, 0, 1, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
      "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "ai": {
      "pulse": "pulse 2s ease-in-out infinite",
      "shimmer": "shimmer 2s linear infinite",
      "slideIn": "slideIn 0.3s cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "density": {
    "mode": ["relaxed", "default", "compact"],
    "current": "default"
  },
  "platform": {
    "web": {
      "output": "css-variables",
      "prefix": "--ds-"
    },
    "mobile": {
      "output": "javascript",
      "multiplier": 1.2
    },
    "voice": {
      "output": "ssml-attributes",
      "volumeMap": {
        "primary": "loud",
        "secondary": "medium",
        "muted": "soft"
      },
      "emphasisMap": {
        "primary": "strong",
        "secondary": "moderate",
        "muted": "reduced"
      }
    },
    "ar": {
      "output": "spatial-units",
      "depthMultiplier": 0.01
    }
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  }
}
