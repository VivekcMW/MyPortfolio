# Gmail SMTP credentials for contact form
# Use your Gmail address and an App Password (not your regular password)
# To generate an App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create a new App Password (select "Mail" + "Other")
# 5. Paste the 16-character password below (no spaces)

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password-here

# Site URL (set this in Netlify environment variables)
# Production: https://uxvivek.netlify.app
# Preview deploys will use Netlify's auto-generated URLs
NEXT_PUBLIC_SITE_URL=https://uxvivek.netlify.app
